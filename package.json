{
  "name": "jp-web-learner",
  "version": "0.1.0",
  "description": "Read Japanese on the web with instant furigana and on-demand, JLPT-aware AI explanations, saved as review cards.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-dict.mjs && vite",
    "build": "node scripts/copy-dict.mjs && vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@sglkc/kuromoji": "^1.1.0",
    "idb": "^8.0.3",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/chrome": "^0.2.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.7"
  }
}
